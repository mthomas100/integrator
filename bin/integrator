#!/usr/bin/env python3
"""integrator: the command. The code lives in integrator_cli.py beside it.

The Claude Code hooks (`integrator hook ...`) run on every edit in every session on this Mac, so they take a fast
path first: with only os and json loaded, find the repo of the file (or the session's folder, without running
git) and leave at once when it has no integrator state, the usual case."""
import os
import sys


def _has_state(path):
    p = os.path.abspath(path)
    while not os.path.exists(p) and os.path.dirname(p) != p:
        p = os.path.dirname(p)
    if not os.path.isdir(p):
        p = os.path.dirname(p)
    while True:
        g = os.path.join(p, ".git")
        if os.path.isdir(g):
            return os.path.exists(os.path.join(g, "integrator", "state.json"))
        if os.path.isfile(g):  # a linked worktree: .git names its gitdir, whose commondir names the shared one
            with open(g) as fh:
                gd = fh.read().strip()[len("gitdir:"):].strip()
            gd = gd if os.path.isabs(gd) else os.path.join(p, gd)
            cf = os.path.join(gd, "commondir")
            if os.path.exists(cf):
                with open(cf) as fh:
                    gd = os.path.join(gd, fh.read().strip())
            return os.path.exists(os.path.join(gd, "integrator", "state.json"))
        if os.path.dirname(p) == p:
            return False
        p = os.path.dirname(p)


if len(sys.argv) == 3 and sys.argv[1] == "hook":
    import json

    raw = sys.stdin.read()
    try:
        data = json.loads(raw or "{}")
        ti = data.get("tool_input") or {}
        where = ti.get("file_path") or ti.get("notebook_path") or data.get("cwd") or os.getcwd()
        if not os.path.isabs(where):
            where = os.path.join(data.get("cwd") or os.getcwd(), where)
        if not _has_state(where):
            sys.exit(0)
    except Exception:
        sys.exit(0)  # hooks fail open
    import io

    sys.stdin = io.StringIO(raw)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from integrator_cli import main  # noqa: E402

sys.exit(main())
